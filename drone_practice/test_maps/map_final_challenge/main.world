<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="main_world">

    <!-- ===== 기본 환경 ===== -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 물리 엔진 설정 -->
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ===== Start 표시 ===== -->
    <include>
      <uri>model://start_marker</uri>
      <name>start_pad</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===== Waypoint 시각화 ===== -->
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp1_marker</name>
      <pose>3.0 0.0 2.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp2_marker</name>
      <pose>8.0 0.0 2.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp3_marker</name>
      <pose>12.0 4.0 2.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp4_marker</name>
      <pose>16.0 0.0 2.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp5_marker</name>
      <pose>20.0 3.0 2.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp6_marker</name>
      <pose>21.0 4.5 2.5 0 0 0</pose>
    </include>

    <!-- ===== 랜딩 패드 ===== -->
    <include>
      <uri>model://landing_pad</uri>
      <name>landing_pad</name>
      <pose>22.0 6.0 0 0 0 0</pose>
    </include>

    <!-- 카메라 시점 -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-4 -6 14 0 0.9 0.65</pose>
      </camera>
    </gui>

    <!-- ===== Exam-like Obstacles ===== -->
    <!-- waypoint 주변은 비우고, 경로 중간 구간 주변에 장애물을 배치 -->

    <!-- 초반 직선 구간 양옆 장애물: 회피 판단 유도 -->
    <model name="obstacle_exam_1">
      <static>true</static>
      <pose>5.5 1.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_exam_2">
      <static>true</static>
      <pose>5.5 -1.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- WP2 -> WP3 구간 주변 장애물 -->
    <model name="obstacle_exam_3">
      <static>true</static>
      <pose>9.0 3.2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_exam_4">
      <static>true</static>
      <pose>11.0 0.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- WP3 -> WP4 구간 주변 장애물 -->
    <model name="obstacle_exam_5">
      <static>true</static>
      <pose>15.3 3.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>3.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_exam_6">
      <static>true</static>
      <pose>12.5 0.4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- WP4 -> WP5 구간 주변 장애물 -->
    <model name="obstacle_exam_7">
      <static>true</static>
      <pose>16.9 2.9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.5</radius><length>3.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>3.0</length></cylinder></geometry>
        </visual>
      </link>
    </model>

    <model name="obstacle_exam_8">
      <static>true</static>
      <pose>19.0 0.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
