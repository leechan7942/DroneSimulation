<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="main_world">

    <!-- ===== 기본 환경 ===== -->
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- 물리 엔진 설정 -->
    <physics name='default_physics' default='0' type='ode'>
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ===== Start 표시 ===== -->
    <include>
      <uri>model://start_marker</uri>
      <name>start_pad</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ===== Waypoint 시각화 ===== -->
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp1_marker</name>
      <pose>3.0 0.0 2.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp2_marker</name>
      <pose>5.0 2.0 2.5 0 0 0</pose>
    </include>
    <include>
      <uri>model://waypoint_marker</uri>
      <name>wp3_marker</name>
      <pose>8.0 5.0 2.5 0 0 0</pose>
    </include>

    <!-- ===== 장애물 ===== -->
    <!-- 장애물 1: 원통 (전봇대 모사) -->

    <!-- 장애물 2: 사각 박스 (작은 빌딩 모사) -->

    <!-- ===== 랜딩 패드 ===== -->
    <include>
      <uri>model://landing_pad</uri>
      <name>landing_pad</name>
      <pose>12.6 5.0 0 0 0 0</pose>
    </include>

    <!-- 카메라 시점 (Gazebo에서 보기 좋게) -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>-3 -3 8 0 0.7 0.5</pose>
      </camera>
    </gui>

  

<!-- ===== Landing Precision Test ===== -->

<model name="obstacle_test1_1">
  <static>true</static>
  <pose>8.8 4.4 1.5 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry><box><size>1 1 3</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>1 1 3</size></box></geometry>
    </visual>
  </link>
</model>

<model name="obstacle_test1_2">
  <static>true</static>
  <pose>10.0 5.7 1.5 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry><box><size>1 1 3</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>1 1 3</size></box></geometry>
    </visual>
  </link>
</model>

<model name="obstacle_test1_3">
  <static>true</static>
  <pose>11.0 4.0 1.5 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
    </collision>
    <visual name="visual">
      <geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
    </visual>
  </link>
</model>

<model name="obstacle_test1_4">
  <static>true</static>
  <pose>-20 -20 1.5 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry><box><size>1 1 3</size></box></geometry>
    </collision>
    <visual name="visual">
      <geometry><box><size>1 1 3</size></box></geometry>
    </visual>
  </link>
</model>

<model name="obstacle_test1_5">
  <static>true</static>
  <pose>-22 -20 1.5 0 0 0</pose>
  <link name="link">
    <collision name="collision">
      <geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
    </collision>
    <visual name="visual">
      <geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
    </visual>
  </link>
</model>

</world>
</sdf>
